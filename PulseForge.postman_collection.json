		{
			"name": "6. Laravel Reverb Realtime & War Room Chat",
			"description": "Live WebSocket demo routes, real-time monitor heartbeat trigger, Incident War Room team chat, and Reverb private channel authentication.",
			"item": [
				{
					"name": "Load Realtime Dashboard (Login as Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const match = pm.response.text().match(/<meta\\s+name=\"csrf-token\"\\s+content=\"([^\"]+)\"/i);",
									"if (match && match[1]) {",
									"    pm.collectionVariables.set('csrf_token', match[1]);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/demo/realtime",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"demo",
								"realtime"
							]
						},
						"description": "Renders the Reverb Realtime Demo UI as `admin@pulseforge.test`, sets the session cookie, and automatically extracts `{{csrf_token}}` for channel authorization requests."
					},
					"response": []
				},
				{
					"name": "Load Realtime Dashboard (Login as DevOps Engineer)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const match = pm.response.text().match(/<meta\\s+name=\"csrf-token\"\\s+content=\"([^\"]+)\"/i);",
									"if (match && match[1]) {",
									"    pm.collectionVariables.set('csrf_token', match[1]);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/demo/realtime?as=engineer",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"demo",
								"realtime"
							],
							"query": [
								{
									"key": "as",
									"value": "engineer"
								}
							]
						},
						"description": "Renders the Reverb Realtime Demo UI as `engineer@pulseforge.test` (Alex Rivers), switches the session cookie, and updates `{{csrf_token}}`."
					},
					"response": []
				},
				{
					"name": "Trigger Monitor Ping & Broadcast Heartbeat",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"monitor_id\": {{monitor_id}}\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/demo/realtime/trigger-check",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"demo",
								"realtime",
								"trigger-check"
							]
						},
						"description": "Probes the selected monitor (`{{monitor_id}}`) immediately and broadcasts `MonitorCheckedEvent` over Reverb to `private-tenant.{{tenant_id}}`. Watch your open browser tab at http://localhost:8080/demo/realtime flash live!"
					},
					"response": []
				},
				{
					"name": "Send Incident War Room Chat Message",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"incident_id\": {{incident_id}},\n    \"message\": \"Investigating elevated latency from Postman War Room client.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/demo/realtime/messages",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"demo",
								"realtime",
								"messages"
