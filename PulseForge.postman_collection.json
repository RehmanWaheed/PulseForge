{
	"info": {
		"_postman_id": "7f3c8e2a-4b19-4c8d-9e5a-202611110001",
		"name": "PulseForge API & Realtime (Laravel 13)",
		"description": "Ready-to-run Postman collection for PulseForge (Multi-Tenant Incident Management, Health Monitoring, Stripe Billing, and Laravel Reverb Realtime WebSockets).\n\nDefault Docker Host Ports:\n- App / API (Nginx): http://localhost:8080\n- Reverb WebSockets: ws://localhost:8085\n- Mailpit UI: http://localhost:8025\n\nTip for Realtime/Broadcast Auth:\nRun '6. Laravel Reverb Realtime & War Room Chat -> Load Realtime Dashboard (Login as Admin)' first so Postman stores your session cookie and automatically extracts {{csrf_token}}.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Health & System",
			"description": "Application health check, root entry point, and Sanctum/authentication utilities.",
			"item": [
				{
					"name": "Application Health Check",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/up",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"up"
							]
						},
						"description": "Laravel built-in health check endpoint."
					},
					"response": []
				},
				{
					"name": "Root Entry (Redirects to Realtime Demo)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								""
							]
						},
						"description": "Redirects (302) to /demo/realtime."
					},
					"response": []
				},
				{
					"name": "Get Sanctum CSRF Cookie",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/sanctum/csrf-cookie",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"sanctum",
								"csrf-cookie"
							]
						},
						"description": "Initializes CSRF protection and stores the XSRF-TOKEN cookie in Postman's cookie jar."
					},
					"response": []
				},
				{
					"name": "Get Authenticated User (Sanctum Bearer)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{sanctum_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/user",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"user"
							]
						},
						"description": "Returns the currently authenticated user via Sanctum. Set the `sanctum_token` collection variable to a valid Personal Access Token before running."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Multi-Tenant Workspace (v1 API)",
			"description": "Endpoints for inspecting active tenant workspaces and testing strict multi-tenancy resolution & isolation.",
			"item": [
				{
					"name": "Get Active Workspace (by X-Tenant-Slug)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const json = pm.response.json();",
									"    if (json && json.id) {",
									"        pm.collectionVariables.set('tenant_id', String(json.id));",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-Tenant-Slug",
								"value": "{{tenant_slug}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/workspace",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"workspace"
							]
						},
						"description": "Resolves the tenant workspace using the `X-Tenant-Slug` header (default: `acme`). Automatically updates `{{tenant_id}}`."
					},
					"response": []
				},
				{
					"name": "Get Active Workspace (by X-Tenant-ID)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-Tenant-ID",
								"value": "{{tenant_id}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/workspace",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"workspace"
							]
						},
						"description": "Resolves the tenant workspace using the numeric `X-Tenant-ID` header."
					},
					"response": []
				},
				{
					"name": "Inspect Secondary Tenant (Cyberdyne Free Plan)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-Tenant-Slug",
								"value": "{{secondary_tenant_slug}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/workspace",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"workspace"
							]
						},
						"description": "Verifies multi-tenant isolation by fetching the seeded `cyberdyne` workspace (Free plan, monitor_limit: 5)."
					},
					"response": []
				},
				{
					"name": "Unknown Tenant Isolation Check (Expect 404)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-Tenant-Slug",
								"value": "nonexistent-workspace",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/workspace",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"workspace"
							]
						},
						"description": "Confirms fail-closed tenancy returns HTTP 404 when a tenant slug does not exist."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Monitors (v1 API)",
			"description": "Tenant-scoped endpoint health monitors protected by pessimistic DB row locking for quota enforcement.",
			"item": [
				{
					"name": "List Tenant Monitors",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const list = pm.response.json();",
									"    if (Array.isArray(list) && list.length > 0 && list[0].id) {",
									"        pm.collectionVariables.set('monitor_id', String(list[0].id));",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-Tenant-Slug",
								"value": "{{tenant_slug}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/monitors",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"monitors"
							]
						},
						"description": "Lists all monitors scoped to the active tenant (`{{tenant_slug}}`). Automatically sets `{{monitor_id}}` to the first monitor's ID."
					},
					"response": []
				},
