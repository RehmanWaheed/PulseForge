						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-Tenant-Slug",
								"value": "{{tenant_slug}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Production Billing API\",\n    \"url\": \"https://api.github.com\",\n    \"check_interval_seconds\": 30,\n    \"expected_status_code\": 200\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/monitors",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"monitors"
							]
						},
						"description": "Creates a monitor with all validated parameters (`name`, `url`, `check_interval_seconds` >= 10, `expected_status_code`)."
					},
					"response": []
				}
			]
		},
